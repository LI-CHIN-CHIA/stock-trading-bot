FROM python:3.12-slim

RUN apt-get update && apt-get install -y \
    libssl-dev ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements-crypto-bot.txt .
RUN pip install --no-cache-dir -r requirements-crypto-bot.txt

COPY ai/        ai/
COPY analysis/  analysis/
COPY utils/     utils/
COPY crypto/    crypto/
COPY crypto_bot.py .

ENV DATA_DIR=/data
ENV CRYPTO_PAPER_TRADING=true

VOLUME ["/data"]

CMD ["python", "crypto_bot.py"]
