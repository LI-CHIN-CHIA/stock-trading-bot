FROM python:3.12-slim

WORKDIR /app

COPY requirements-trading-bot.txt .
COPY wheels/ wheels/
RUN pip install --no-cache-dir \
    -r requirements-trading-bot.txt
RUN pip install --no-cache-dir --no-index --find-links wheels/ \
    pandas_market_calendars \
    exchange_calendars \
    korean_lunar_calendar \
    pyluach \
    toolz \
    tzdata

COPY ai/        ai/
COPY analysis/  analysis/
COPY trader/    trader/
COPY utils/     utils/
COPY us_stock_bot.py .

ENV DATA_DIR=/data/us
VOLUME ["/data"]

CMD ["python", "us_stock_bot.py"]
